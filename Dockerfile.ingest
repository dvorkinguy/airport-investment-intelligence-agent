# Ingestion job image (Cloud Run Job `airport-ingest`, ADR-005 amended).
#
# Deliberately a SEPARATE image from Dockerfile (the `airport-agent` service).
# `.dockerignore` excludes db/ and ingestion/ from the agent image on purpose
# ("Not part of the backend image") - that boundary is a decision, not an
# oversight, and this file does not touch it or the shared Dockerfile.
#
# Built via ops/cloudbuild.ingest.yaml from a STAGED context (not repo root),
# so the shared .dockerignore never enters the picture and there is no
# dependency on Dockerfile-scoped dockerignore override behaviour (a BuildKit
# feature that could not be verified on this machine - no local Docker).
#
# Runs `python -m ingestion.refresh` via a module search path rooted at
# /app, same interpreter/deps as the agent image (shared pyproject.toml/
# uv.lock), but only ingestion/ + db/ ever land in the filesystem here.

FROM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# --no-install-project: we want the shared dependency set (httpx, psycopg,
# etc.) but not an editable install of services/agent - the job never
# imports it.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY ingestion/ ./ingestion/
COPY db/ ./db/

# --- Runtime -------------------------------------------------------------
FROM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36 AS runtime

ARG GIT_SHA=dev
LABEL org.opencontainers.image.source="https://github.com/dvorkinguy/airport-investment-intelligence-agent" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.title="airport-ingest" \
      org.opencontainers.image.description="Airport investment intelligence agent - scheduled ingestion job (ingestion/refresh.py orchestrator)"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

RUN useradd --create-home --uid 1001 ingest

WORKDIR /app

COPY --from=builder --chown=ingest:ingest /app/.venv /app/.venv
COPY --from=builder --chown=ingest:ingest /app/ingestion /app/ingestion
COPY --from=builder --chown=ingest:ingest /app/db /app/db

# Empty, writable - build_*.py download into data/raw/ at runtime. Never
# baked in: raw zips are gitignored build cache, not image content, and a
# stale baked-in file would make a builder's own "already have it" check lie.
RUN mkdir -p /app/data/raw && chown -R ingest:ingest /app/data

USER ingest

CMD ["python", "-m", "ingestion.refresh", "--trigger", "manual"]
