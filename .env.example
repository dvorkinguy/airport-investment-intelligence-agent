# Airport Investment Intelligence Agent - environment template
# Copy to .env and fill in real values. .env is gitignored and never committed.

# --- Required (Tier 1) ---
# LLM gateway - OpenRouter (spend-capped key). Model is swappable by env alone.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
AGENT_MODEL=openai/gpt-4o-mini

# Neon Postgres - data snapshots, scoring views, conversation checkpoints
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Tier 2 (optional locally) ---
# Langfuse tracing (gate 1 of the production framework)
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Clerk auth (chat behind sign-in; landing stays public)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key
CLERK_SECRET_KEY=sk_test_your-key

# Agent backend URL for the web app
AGENT_API_URL=http://localhost:8000

# --- Optional backend tuning (defaults shown; full table: services/agent/README.md) ---
# CORS_ORIGINS=["http://localhost:3000"]  # web UI on another port? add its origin here
# REPO_BACKEND=auto                       # force "postgres" or "fixture"
# LOG_QUERIES=true                        # false disables the queries audit table
# MAX_TOOL_ITERATIONS=8
# LANGFUSE_ENVIRONMENT=dev
# LANGFUSE_BASE_URL=                      # v4 name; wins over LANGFUSE_HOST if both set
