# Airport Investment Intelligence Agent - web app environment template
# Copy to .env.local for local development.

# Agent backend base URL. Exposed to the browser (NEXT_PUBLIC_) - no secret here.
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000

# Optional. Both must be set together to turn auth on (src/lib/clerk-config.ts).
# With either missing, the app runs exactly as today: landing and /chat both
# public, no Clerk code path executes, middleware never runs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
